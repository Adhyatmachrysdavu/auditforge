{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "py.hardcoded-secret",
              "name": "Hardcoded Secret",
              "shortDescription": { "text": "Hardcoded secret detected" },
              "properties": { "security-severity": "7.5", "tags": ["CWE-798", "security"] },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "py.weak-hash",
              "name": "Weak Hash (MD5)",
              "shortDescription": { "text": "Use of weak hashing algorithm" },
              "properties": { "security-severity": "4.0", "tags": ["CWE-327"] },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "py.hardcoded-secret",
          "level": "error",
          "message": { "text": "Hardcoded API key found in source." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "app/config.py" }, "region": { "startLine": 12 } } }
          ]
        },
        {
          "ruleId": "py.weak-hash",
          "level": "warning",
          "message": { "text": "MD5 is a weak hashing algorithm; use SHA-256." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "app/util.py" }, "region": { "startLine": 30 } } }
          ]
        }
      ]
    }
  ]
}
