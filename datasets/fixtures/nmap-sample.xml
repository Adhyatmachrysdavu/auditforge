<?xml version="1.0"?>
<nmaprun scanner="nmap" args="nmap -sV --script ssl-enum-ciphers,ssl-heartbleed -oX out target.example.com">
  <host>
    <address addr="192.0.2.10" addrtype="ipv4"/>
    <hostnames><hostname name="target.example.com" type="user"/></hostnames>
    <ports>
      <port protocol="tcp" portid="22">
        <state state="open" reason="syn-ack"/>
        <service name="ssh" product="OpenSSH" version="7.4"/>
      </port>
      <port protocol="tcp" portid="443">
        <state state="open" reason="syn-ack"/>
        <service name="https" product="nginx" version="1.14.0"/>
        <script id="ssl-enum-ciphers" output="TLSv1.0 supported (weak cipher suites offered)"/>
        <script id="ssl-heartbleed" output="VULNERABLE: The Heartbleed Bug. CVE-2014-0160 detected."/>
      </port>
    </ports>
  </host>
</nmaprun>
