# AuditForge — salin ke .env dan isi nilainya (jangan commit .env)
#
#   cp .env.example .env
#
# Untuk PENGEMBANGAN lokal, berkas ini bisa dipakai apa adanya.
# Untuk PRODUKSI, setel ENVIRONMENT=production dan ganti semua nilai yang
# ditandai [WAJIB DIGANTI]. Aplikasi akan MENOLAK MENYALA bila salah satunya
# masih bernilai bawaan — lihat backend/app/core/hardening.py.

# development | production
ENVIRONMENT=development

# --- Keamanan / autentikasi ---------------------------------------------
# [WAJIB DIGANTI] Kunci penanda-tangan JWT. Buat dengan:
#   openssl rand -hex 32
# Nilai bawaannya tertulis di repositori publik; siapa pun yang membacanya
# dapat menandatangani token admin sendiri.
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# [WAJIB DIGANTI] Kredensial admin awal (dipakai `python -m app.scripts.seed`).
# Login memakai EMAIL, bukan nama pengguna.
SEED_ADMIN_EMAIL=admin@auditforge.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator

# --- Basis data & broker -------------------------------------------------
# [WAJIB DIGANTI] Ganti sandi `auditforge` kedua pada URL di bawah, dan samakan
# dengan POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://auditforge:auditforge@postgres:5432/auditforge
POSTGRES_USER=auditforge
POSTGRES_PASSWORD=auditforge
POSTGRES_DB=auditforge

REDIS_URL=redis://redis:6379/0

# --- Penyimpanan objek (MinIO) -------------------------------------------
# [WAJIB DIGANTI] MINIO_SECRET_KEY. Berkas scan mentah dan lampiran bukti
# tersimpan di sini, bukan di basis data.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=auditforge
MINIO_SECRET_KEY=auditforge-secret
MINIO_BUCKET=auditforge
MINIO_SECURE=false

# --- Kecerdasan Buatan ---------------------------------------------------
# ai_format: "openai" (OpenAI-compatible: OpenRouter/Ollama/OpenAI) | "anthropic"
# Nilai ini juga dapat diubah runtime lewat Admin UI tanpa build ulang.
# Untuk data sangat rahasia, arahkan AI_BASE_URL ke model lokal/on-premise agar
# tak ada teks yang keluar dari jaringan sendiri.
AI_FORMAT=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Auto-ingest folder terpantau (R3) -----------------------------------
# Beat memindai <WATCH_DIR>/inbox/<engagement_id>/ lalu memindahkan berkas ke
# processed/ atau failed/.
WATCH_ENABLED=true
WATCH_DIR=/watch
WATCH_INTERVAL_SECONDS=30
WATCH_SETTLE_SECONDS=5

# --- Branding laporan ----------------------------------------------------
# Dapat ditimpa runtime lewat Admin UI.
BRAND_ORG_NAME=PT Suryasoft Konsultama
BRAND_REPORT_TITLE=Laporan Audit Keamanan
BRAND_ACCENT=#1E5F9F
