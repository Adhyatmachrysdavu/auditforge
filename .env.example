# AuditForge — salin ke .env dan isi nilainya (jangan commit .env)

# --- Kecerdasan Buatan ---
# Provider: "ollama" (LLM lokal gratis, on-premise) atau "anthropic" (Claude API).
AI_PROVIDER=ollama
# Ollama lokal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
# Anthropic/Claude (produksi)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Basis data & broker ---
DATABASE_URL=postgresql+psycopg://auditforge:auditforge@postgres:5432/auditforge
REDIS_URL=redis://redis:6379/0

# --- Penyimpanan objek (MinIO) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=auditforge
MINIO_SECRET_KEY=auditforge-secret

# --- Umum ---
ENVIRONMENT=development
